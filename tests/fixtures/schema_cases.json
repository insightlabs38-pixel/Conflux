    },
    {
      "name": "a boolean is not a number",
      "schema": {
        "type": "number"
      },
      "value": false,
      "problems": [
        {
          "path": "",
          "code": "type"
        }
      ]
    },
    {
      "name": "a boolean",
      "schema": {
        "type": "boolean"
      },
      "value": true,
      "normalized": true
    },
    {
      "name": "a number is not a boolean",
      "schema": {
        "type": "boolean"
      },
      "value": 1,
      "problems": [
        {
          "path": "",
          "code": "type"
        }
      ]
    },
    {
      "name": "null where null is allowed",
      "schema": {
        "type": ["integer", "null"],
        "minimum": 1
      },
      "value": null,
      "normalized": null
