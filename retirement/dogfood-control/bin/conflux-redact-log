#!/usr/bin/env python3
"""Line-oriented credential redaction for unattended model and TUI logs."""
import re,sys
PATTERNS=[
 re.compile(r'(?i)(?:sk|rk|pk|gho|ghp|github_pat|xox[baprs]|ya29|glpat)-?[A-Za-z0-9_./+-]{16,}'),
 re.compile(r'(?i)(authorization\s*:\s*bearer\s+)[A-Za-z0-9._~+/-]{12,}'),
 re.compile(r'(?i)((?:OPENAI_API_KEY|ANTHROPIC_API_KEY|CODEX_ACCESS_TOKEN|GH_TOKEN|GITHUB_TOKEN)\s*[=:]\s*)[^\s,;"\']+'),
]
for line in sys.stdin:
 for p in PATTERNS: line=p.sub('[REDACTED_CREDENTIAL]',line)
 sys.stdout.write(line); sys.stdout.flush()
