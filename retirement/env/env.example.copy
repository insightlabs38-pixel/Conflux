# Copy to `.env`; replace secrets and passwords before using real data.
DJANGO_SECRET_KEY=change-me-in-deployments
RECORD_SIGNING_KEY_SEED=change-me-in-deployments
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=conflux
POSTGRES_USER=conflux
POSTGRES_PASSWORD=conflux
POSTGRES_PORT=5432

VALKEY_PORT=6379

# Object store (RustFS by default; SeaweedFS in the compat profile)
S3_ACCESS_KEY=conflux
S3_SECRET_KEY=conflux-secret
S3_BUCKET_NAME=conflux-artifacts
S3_PORT=9000
S3_CONSOLE_PORT=9001
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333

# Public entry point
CONFLUX_PORT=8080

UVICORN_WORKERS=2
# Concurrent requests each worker runs at once; each holds one PostgreSQL connection.
# Keep UVICORN_WORKERS x this + Celery under Postgres max_connections (default 100).
CONFLUX_MAX_INFLIGHT_REQUESTS=12

# Optional OpenID Connect sign-in (off unless OIDC_ISSUER is set; password login always stays).
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://conflux.example.com/api/v1/accounts/oidc/callback/
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# OIDC_DEFAULT_WORKSPACE_SLUG=my-workspace
