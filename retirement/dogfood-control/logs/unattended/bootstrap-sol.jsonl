me/dogfood-control/execution/TASKS.yaml:1706:  - receipt emitted with verification evidence\\n/home/dogfood-control/execution/TASKS.yaml:1739:  - receipt emitted with verification evidence\\n/home/dogfood-control/execution/TASKS.yaml:1749:  title: Submission receipt/history UX\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/home/dogfood-control/logs/unattended/bootstrap-sol.jsonl:27:{\"type\":\"item.started\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"find /home/dogfood-control -maxdepth 4 -type f | rg 'receipt.*schema|schema.*receipt|bootstrap-.*jsonl' | tail -25\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n/home/dogfood-control/logs/unattended/bootstrap-sol.jsonl:30:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"find /home/dogfood-control -maxdepth 4 -type f | rg 'receipt.*schema|schema.*receipt|bootstrap-.*jsonl' | tail -25\\\"\",\"aggregated_output\":\"/home/dogfood-control/logs/unattended/bootstrap-sol.jsonl\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/home/dogfood-control/logs/unattended/bootstrap-sol.jsonl:32:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"ls -la; git show-ref; sed -n '1,120p' /home/dogfood-control/bin/conflux-control\\\"\",\"aggregated_output\":\"total 12\\ndrwx------  3 insightlabs38 insightlabs38 4096 Sep 26 18:00 .\\ndrwxr-x--- 18 insightlabs38 insightlabs38 4096 Sep 26 18:00 ..\\ndrwx------  7 insightlabs38 insightlabs38 4096 Sep 26 18:00 .git\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Deterministic external queue controller for Conflux hackathon execution.\\\"\\\"\\\"\\nimport argparse, datetime as dt, fcntl, fnmatch, json, os, subprocess, sys, tempfile\\nfrom pathlib import Path\\nimport yaml\\nROOT=Path(os.environ.get('CONFLUX_CONTROL_ROOT','/home/dogfood-control/execution'))\\nWORKTREE_ROOT=Path(os.environ.get('CONFLUX_WORKTREE_ROOT','/home/insightlabs38/conflux-worktrees'))\\nPLAN=Path(os.environ.get('CONFLUX_PLAN_ROOT','/home/dogfood-control/plan'))\\nSTATE=ROOT/'OWNERSHIP.yaml'; LOCK=ROOT/'.controller.lock'\\nBFILE=ROOT/'BATCHES.yaml'; TFILE=ROOT/'TASKS.yaml'; OFILE=STATE\\n_campaign_start=os.environ.get('CONFLUX_START_UTC','').strip()\\nKICKOFF=dt.datetime.fromisoformat(_campaign_start) if _campaign_start else dt.datetime.max.replace(tzinfo=dt.timezone.utc)\\nACTIVE={'ACTIVE','RESERVED','REVIEW'}\\nLANES={'claude':'claude-sonnet','sol':'codex-sol','luna':'bulk','freebuff':'bulk','human':'human'}\\ndef utc(): return dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')\\ndef load_yaml(path): return yaml.safe_load(path.read_text())\\ndef atomic_yaml(path,obj):\\n    data=yaml.safe_dump(obj,sort_keys=False,allow_unicode=True,width=110)\\n    atomic_text(path,data)\\ndef atomic_text(path,data):\\n    path.parent.mkdir(parents=True,exist_ok=True)\\n    fd,tmp=tempfile.mkstemp(prefix='.'+path.name+'.',dir=path.parent)\\n    try:\\n        with os.fdopen(fd,'w') as f: f.write(data); f.flush(); os.fsync(f.fileno())\\n        os.replace(tmp,path)\\n    finally:\\n        try: os.unlink(tmp)\\n        except FileNotFoundError: pass\\ndef state():\\n    s=load_yaml(STATE) if STATE.exists() else {}\\n    s.setdefault('leases',[]); s.setdefault('reserved_batches',[]); s.setdefault('completed_batches',[]); s.setdefault('open_gates',[]); s.setdefault('blockers',{})\\n    s.setdefault('capacity',{}).setdefault('luna_max_active',1); s['capacity'].setdefault('luna_expansion_enabled',False); s['capacity'].setdefault('freebuff_max_active',1)\\n    s.setdefault('provider_notes',[]); s.setdefault('last_green_main',None); s.setdefault('runtime_mode','NORMAL')\\n    return s\\ndef save_state(s): atomic_yaml(STATE,s)\\ndef maps():\\n    b=load_yaml(BFILE)['batches']; t=load_yaml(TFILE)['tasks']\\n    return {x['id']:x for x in b},{x['id']:x for x in t}\\ndef fail(msg): print('ERROR: '+msg,file=sys.stderr); raise SystemExit(2)\\ndef lock():\\n    LOCK.parent.mkdir(parents=True,exist_ok=True); f=open(LOCK,'a+')\\n    fcntl.flock(f.fileno(),fcntl.LOCK_EX); return f\\ndef gate_ok(batch,s):\\n    bid=batch['id']\\n    for dep in batch.get('dependencies',[]):\\n        if dep in s.get('completed_batches',[]): continue\\n        if dep in s.get('open_gates',[]): continue\\n        return False\\n    return True\\ndef paths_overlap(a,b):\\n    if a==b or a=='repository root' or b=='repository root': return True\\n    def root(p): return p.removesuffix('/**').rstrip('/')\\n    ar,br=root(a),root(b)\\n    return ar==br or ar.startswith(br+'/') or br.startswith(ar+'/') or fnmatch.fnmatchcase(ar, b) or fnmatch.fnmatchcase(br,a)\\ndef conflict(paths,leases,exclude=None):\\n    for l in leases:\\n        if l.get('id')==exclude: continue\\n        for a in paths:\\n            for b in l.get('owned_paths',[]):\\n                if paths_overlap(a,b): return l\\n    return None\\ndef ready_task(t,batches,tasks,s,leases,reserved):\\n    if t.get('status','').upper() in {'DONE','ACTIVE','RESERVED','REVIEW'}: return False\\n    if t.get('risk')=='high' or not t.get('bulk_eligible',False) or t.get('preferred_executor')=='human': return False\\n    batch=batches.get(t['batch'])\\n    if not batch or not gate_ok(batch,s): return False\\n    # BOOT-B00 is an exclusive senior bootstrap gate; no bulk task lane can enter it.\\n    if t.get('batch')=='BOOT-B00' and 'BOOT-B00' not in s.get('completed_batches',[]): return False\\n    if any(d not in tasks or tasks[d].get('status','').upper()!='DONE' for d in t.get('task_dependencies',[])): return False\\n    if any(d not in s.get('completed_batches',[]) and d not in s.get('open_gates',[]) for d in t.get('batch_dependencies',[])): return False\\n    if any(r['id']==t['batch'] and r['lane'] in ('claude','sol') for r in reserved): return False\\n    if conflict(t.get('owned_paths',[]),leases+reserved): return False\