#!/usr/bin/env bash
# Faster e2e: read-only, isolated-mutation and canary tiers run concurrently (see scripts/e2e-tiers
# and tests/e2e/tiers.json). Mutating specs run on throwaway fixtures, the lifecycle canary on its
# own fixture, so no `scripts/demo-reset` is needed between runs. `make demo-e2e` remains the
# authoritative serial run against the reset demo event.
set -uo pipefail
cd "$(dirname "$0")/.."
exec python3 scripts/e2e-tiers "$@"
