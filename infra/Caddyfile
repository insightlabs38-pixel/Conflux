:80 {
	# Collected public styles are served from the volume shared with Django.
	@objects path /{$S3_BUCKET_NAME}/*
	handle @objects {
		reverse_proxy objectstore:9000
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	# The browser workspace app: one shell page; every path under /app/ is a client-side route
	# (/app/w/<workspace>/<view>, /app/person/<id>, ...), so deep links and refreshes get the shell.
	# Legacy query-string URLs (/?workspace=..&view=..) land here and the app redirects them.
	@root path /
	redir @root /app/?{query} 302
	@app path /app /app/*
	handle @app {
		rewrite * /app/index.html
		root * /srv/static
		file_server
	}
	handle {
		reverse_proxy app:8000
	}
}
