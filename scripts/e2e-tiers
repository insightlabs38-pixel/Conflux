#!/usr/bin/env python3
"""Tiered browser runner (PD-B03-T04). Tiers live in tests/e2e/tiers.json; every spec is in exactly one.

  read-only          reference scenario (seed 7), one Playwright run, 4 workers, never mutates shared state
  self-isolating     specs that provision their own fixtures (fixtures.ts); run inside the read-only run
  isolated-mutation  one throwaway `iso-min` fixture PER SPEC FILE, files run concurrently
  canary             the only serial chain: lifecycle -> scenes -> uiv2-organizer -> uiv2-final-states on
                     its own `canary` fixture (full create->submit->judge->publish path, untouched by others)

Usage: scripts/e2e-tiers check
       scripts/e2e-tiers run [tier ...]      PR/full: all three tiers concurrently (default) or the named ones
       scripts/e2e-tiers smoke               seconds: sign-in, role workspaces and public pages, desktop only
       scripts/e2e-tiers affected [--base REF] [--list]
                                             only specs mapped (tests/e2e/affected.json) from paths changed vs REF
                                             (default HEAD: uncommitted + untracked); --list prints the selection
Release stays authoritative and broader: `make demo-e2e` (serial, reset-first, seed 7) plus the canary.
Env:   E2E_SKIP_PREFLIGHT  E2E_ISOLATED_JOBS (3)  E2E_READONLY_WORKERS (4)  E2E_MANAGE  E2E_BASE_URL  E2E_KEEP_FIXTURES=1
Fixtures are disposed on success and kept (slug printed) on failure; `make e2e-fixture-sweep` cleans up.
Specs run unmodified: fixture identity reaches them through E2E_DEMO_SEED / E2E_DEMO_PASSWORD.
"""
import json
import os
import subprocess
import sys
import threading
from concurrent.futures import ThreadPoolExecutor
from fnmatch import fnmatch
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPECS = ROOT / "tests/e2e"
CONFIG = "tests/e2e/playwright.config.ts"
LOGS = ROOT / "artifacts/e2e-fast"
RUN_TIERS = ("read-only", "isolated-mutation", "canary")
_print = threading.Lock()


def say(line):
    with _print:
        print(line, flush=True)


def tiers():
    return json.loads((SPECS / "tiers.json").read_text())


def check():
    declared = [(t, s) for t, names in tiers().items() for s in names]
    on_disk = {p.name.removesuffix(".spec.ts") for p in SPECS.glob("*.spec.ts")}
    problems = []
    seen = {}
    for tier, spec in declared:
        if spec in seen:
            problems.append(f"{spec} is in both {seen[spec]} and {tier}")
        seen[spec] = tier
        if spec not in on_disk:
            problems.append(f"{tier}: {spec}.spec.ts does not exist")
    cfg = json.loads((SPECS / "affected.json").read_text())
    named = set(cfg["smoke"]) | {sp for r in cfg["rules"] for sp in r["specs"]}
    problems += [f"affected.json names unclassified spec {sp}" for sp in sorted(named - set(seen))]
    problems += [f"{s}.spec.ts is not classified in tests/e2e/tiers.json" for s in sorted(on_disk - set(seen))]
    return problems


def manage(*args):
    prefix = os.environ.get("E2E_MANAGE", "docker compose exec -T app python manage.py").split()
    out = subprocess.run([*prefix, "e2e_fixture", *args], cwd=ROOT, capture_output=True, text=True)
    if out.returncode:
        raise RuntimeError(f"e2e_fixture {' '.join(args)}: {(out.stderr.strip().splitlines() or ['failed'])[-1]}")
    return out.stdout.strip().splitlines()[-1] if out.stdout.strip() else ""


def failed_specs(group):
    """Spec names with a failing test in the group's JSON report."""
    try:
        report = json.loads((LOGS / group / "report.json").read_text())
    except (OSError, ValueError):
        return []
    found = set()

    def walk(suite):
        if any(not spec.get("ok", True) for spec in suite.get("specs", [])):
            found.add(Path(suite.get("file", "")).name.removesuffix(".spec.ts"))
        for child in suite.get("suites", []):
            walk(child)

    for suite in report.get("suites", []):
        walk(suite)
    return sorted(found - {""})


def playwright(group, specs, env=None, workers=1, extra=(), diagnose=True):
    LOGS.mkdir(parents=True, exist_ok=True)
    log = LOGS / f"tier-{group}.log"
    with log.open("w") as fh:
        code = subprocess.run(
            ["npx", "playwright", "test", "-c", CONFIG, f"--workers={workers}", *extra, *specs],
            cwd=ROOT, env={**os.environ, "E2E_GROUP": group, **(env or {})}, stdout=fh, stderr=subprocess.STDOUT,
        ).returncode
    summary = [l.strip() for l in log.read_text().splitlines() if "✘" in l or " passed" in l or " failed" in l or " skipped" in l]
    say(f"[{group}] exit {code}: " + "; ".join(summary[-4:]))
    if code and diagnose and not os.environ.get("E2E_NO_DIAGNOSE"):
        diagnostic_rerun(group, env, extra)
    return code


def diagnostic_rerun(group, env, extra):
    """Failure-first tracing: nothing is recorded on the way in, so re-run only the failing files
    once with a trace. Diagnostic only: the tier stays failed whatever the re-run does. Chains that
    consume state (the canary) are not re-run; their fixture is kept instead."""
    specs = failed_specs(group)
    if not specs or any(tier_of(s) == "canary" for s in specs):
        return
    diag = f"{group}-diagnose"
    say(f"[{group}] diagnostic re-run with trace: {', '.join(specs)}")
    code = subprocess.run(
        ["npx", "playwright", "test", "-c", CONFIG, "--workers=1", *extra, *specs],
        cwd=ROOT, env={**os.environ, "E2E_GROUP": diag, "E2E_TRACE": "on", **(env or {})},
        stdout=(LOGS / f"tier-{diag}.log").open("w"), stderr=subprocess.STDOUT,
    ).returncode
    verdict = "failed again" if code else "PASSED on re-run: treat as flaky/state-dependent, not as a pass"
    say(f"[{group}] diagnostic re-run {verdict}; traces in artifacts/e2e-fast/{diag}/results/**/trace.zip (npx playwright show-trace)")


def with_fixture(profile, group, specs):
    """Provision a fixture, run specs one file at a time against it, dispose unless something failed."""
    fixture = json.loads(manage("create", profile))
    env = {"E2E_DEMO_SEED": str(fixture["seed"]), "E2E_DEMO_PASSWORD": fixture["password"]}
    code = 0
    for spec in specs:
        code = playwright(f"{group}-{spec}" if len(specs) > 1 else group, [spec], env) or code
        if code:
            break
    if code or os.environ.get("E2E_KEEP_FIXTURES"):
        say(f"[{group}] kept fixture {fixture['slug']} (seed {fixture['seed']}); dispose: manage.py e2e_fixture dispose {fixture['slug']}")
    else:
        manage("dispose", fixture["slug"])
    return code


def run_read_only(specs=None):
    t = tiers()
    return playwright("read-only", specs or t["read-only"] + t["self-isolating"], workers=int(os.environ.get("E2E_READONLY_WORKERS", "4")))


def run_isolated(specs=None):
    jobs = int(os.environ.get("E2E_ISOLATED_JOBS", "3"))
    with ThreadPoolExecutor(jobs) as pool:
        codes = list(pool.map(lambda s: with_fixture("iso-min", f"iso-{s}", [s]), specs or tiers()["isolated-mutation"]))
    return int(any(codes))


def canary_chain(specs=None):
    """Later chain members read what earlier ones create: run the chain up to the last selected one."""
    chain = tiers()["canary"]
    return chain[: max(chain.index(s) for s in specs) + 1] if specs else chain


def run_canary(specs=None):
    return with_fixture("canary", "canary", canary_chain(specs))


RUNNERS = {"read-only": run_read_only, "isolated-mutation": run_isolated, "canary": run_canary}


def tier_of(spec):
    t = tiers()
    return "read-only" if spec in t["self-isolating"] else next((k for k in RUN_TIERS if spec in t[k]), None)


def changed_paths(base):
    tracked = subprocess.run(["git", "diff", "--name-only", base], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
    fresh = subprocess.run(["git", "ls-files", "-o", "--exclude-standard"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
    return sorted(set(tracked + fresh))


def select_affected(paths):
    """(specs, reasons): union of mapped specs; 'all' wins; unmapped source paths fall back to smoke."""
    cfg = json.loads((SPECS / "affected.json").read_text())
    hit = lambda path, globs: any(fnmatch(path, g) for g in globs)
    specs, reasons, everything = set(), [], False
    for path in paths:
        direct = path.startswith("tests/e2e/") and path.endswith(".spec.ts")
        if hit(path, cfg["all"]):
            everything = True
            reasons.append(f"{path} -> ALL (shared infrastructure)")
        elif direct and tier_of(Path(path).name.removesuffix(".spec.ts")):
            name = Path(path).name.removesuffix(".spec.ts")
            specs.add(name)
            reasons.append(f"{path} -> {name}")
        elif hit(path, cfg["none"]):
            reasons.append(f"{path} -> none")
        else:
            mapped = sorted({sp for r in cfg["rules"] if hit(path, r["paths"]) for sp in r["specs"]})
            if mapped:
                specs.update(mapped)
                reasons.append(f"{path} -> {', '.join(mapped)}")
            elif path.startswith(("src/", "tests/e2e/", "scripts/")):
                specs.update(cfg["smoke"])
                reasons.append(f"{path} -> smoke (unmapped; add a rule to tests/e2e/affected.json)")
            else:
                reasons.append(f"{path} -> none")
    return (None if everything else sorted(specs)), reasons


def preflight():
    if os.environ.get("E2E_SKIP_PREFLIGHT"):
        return True
    # Reuse the running stack; only start/seed what is missing (scripts/e2e-stack).
    if subprocess.run([str(ROOT / "scripts/e2e-stack"), "ensure", "--fix"], cwd=ROOT).returncode:
        print("preflight failed: fix the stack (see above) or set E2E_SKIP_PREFLIGHT=1", file=sys.stderr)
        return False
    return True


def run_tiers(chosen, selection=None):
    results = {}

    def go(tier):
        try:
            results[tier] = RUNNERS[tier](selection.get(tier) if selection else None)
        except Exception as exc:  # provisioning failures must fail the run loudly, not skip
            say(f"[{tier}] ERROR {exc}")
            results[tier] = 1

    threads = [threading.Thread(target=go, args=(t,)) for t in chosen]
    [t.start() for t in threads]
    [t.join() for t in threads]
    say("== " + ", ".join(f"{t}: {'ok' if results[t] == 0 else 'FAILED'}" for t in chosen))
    return int(any(results.values()))


def main(argv):
    problems = check()
    if argv[:1] == ["check"] or problems:
        for p in problems:
            print(f"tiers: {p}", file=sys.stderr)
        print("tiers: OK" if not problems else "tiers: FAILED", file=sys.stderr)
        return 1 if problems else 0
    command = argv[0] if argv else "run"
    if command == "smoke":
        if not preflight():
            return 1
        smoke = json.loads((SPECS / "affected.json").read_text())["smoke"]
        code = playwright("smoke", smoke, workers=len(smoke), extra=("--project=desktop",))
        say(f"== smoke: {'ok' if code == 0 else 'FAILED'}")
        return code
    if command == "affected":
        base = argv[argv.index("--base") + 1] if "--base" in argv else "HEAD"
        paths = changed_paths(base)
        specs, reasons = select_affected(paths)
        for r in reasons:
            say(f"  {r}")
        if specs is None:
            say(f"affected vs {base}: ALL tiers (shared infrastructure changed)")
            selection = None
        elif not specs:
            say(f"affected vs {base}: nothing to run ({len(paths)} changed path(s) map to no browser spec)")
            return 0
        else:
            selection = {}
            for spec in specs:
                selection.setdefault(tier_of(spec), []).append(spec)
            say(f"affected vs {base}: " + "; ".join(f"{t}: {', '.join(v)}" for t, v in selection.items()))
            if "canary" in selection:
                say("  canary runs as a chain: " + " -> ".join(canary_chain(selection["canary"])))
        if "--list" in argv or not preflight():
            return 0 if "--list" in argv else 1
        return run_tiers([t for t in RUN_TIERS if selection is None or t in selection], selection)
    chosen = argv[1:] if command == "run" and argv[1:] else list(RUN_TIERS)
    unknown = [t for t in chosen if t not in RUNNERS]
    if command not in ("run",) or unknown:
        print(f"usage: e2e-tiers check|run [tier...]|smoke|affected [--base REF] [--list]; unknown {unknown or command}", file=sys.stderr)
        return 2
    return run_tiers(chosen) if preflight() else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
