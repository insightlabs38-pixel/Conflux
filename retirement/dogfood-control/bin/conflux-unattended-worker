#!/usr/bin/env python3
"""One-lease-at-a-time headless senior/bulk lane runner."""
import datetime as dt,fnmatch,json,os,pathlib,re,shlex,subprocess,sys,time,yaml
ROOT=pathlib.Path('/home/dogfood-control'); REPO=pathlib.Path(os.environ.get('CONFLUX_REPO_ROOT','/home/insightlabs38/conflux')); WTROOT=pathlib.Path(os.environ.get('CONFLUX_WORKTREE_ROOT','/home/insightlabs38/conflux-worktrees'))
H0=dt.datetime.fromisoformat(os.environ['CONFLUX_START_UTC']); STOP=dt.datetime.fromisoformat(os.environ['CONFLUX_END_UTC'])-dt.timedelta(minutes=10)
BOUNDS={'claude':6600,'sol':6000,'luna':4500}; IDLE=2400
def now(): return dt.datetime.now(dt.timezone.utc)
def log(name,obj):
 p=ROOT/'logs/unattended'/name; p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('a') as f: f.write(json.dumps({'at':now().isoformat(),**obj})+'\n')
def heartbeat(lane,unit=None,session=None):
 p=ROOT/'run/heartbeats'/f'{lane}.json'; p.parent.mkdir(parents=True,exist_ok=True); tmp=p.with_suffix('.tmp')
 tmp.write_text(json.dumps({'lane':lane,'unit':unit,'session':session,'at':now().isoformat()})+'\n'); os.chmod(tmp,0o600); os.replace(tmp,p)
def run(args,cwd=None,check=True):
 r=subprocess.run(args,cwd=cwd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
 if check and r.returncode: raise RuntimeError(f'{args[0]} exited {r.returncode}: {r.stdout[-1000:]}')
 return r.stdout.strip()
def ctrl(*args): return run([str(ROOT/'bin/conflux-control'),*args],check=False)
def load():
 c=ROOT/'execution'; return yaml.safe_load((c/'BATCHES.yaml').read_text())['batches'],yaml.safe_load((c/'TASKS.yaml').read_text())['tasks']
def existing_lease(lane):
 data=yaml.safe_load((ROOT/'execution/OWNERSHIP.yaml').read_text()) or {}
 return next((x for x in data.get('leases',[])+data.get('reserved_batches',[]) if x.get('lane')==lane),None)
def task_packet(lane,ident,batch=False,branch=None,wt=None):
 batches,tasks=load(); c=ROOT/'execution'
 obj=next(x for x in batches if x['id']==ident) if batch else next(x for x in tasks if x['id']==ident)
 branch=branch or f'{lane}/{ident}'
 wt=pathlib.Path(wt) if wt else (WTROOT/'freebuff-lane' if lane=='freebuff' else WTROOT/f'{lane}-{ident}')
 taskrows=[x for x in tasks if x['id'] in obj.get('task_ids',[])] if batch else [obj]
 text=['UNATTENDED ASSIGNMENT — DO NOT SELECT OR CLAIM OTHER WORK.','Exact assigned '+('batch' if batch else 'task')+': '+ident,'Executor lane: '+lane,'Branch and isolated worktree are already assigned.','Follow canonical dependencies and the frozen architecture. Keep T1 correctness as minimum product priority; once its dependencies/work are complete, keep taking eligible T2 and later Core work. No artificial tier cutoff or idling at tier boundaries.']
 text += ['Read first with targeted rg/grep/sed: execution/AGENTS.md, the relevant batch/task definitions, domain plan sections, and lane protocol. Do not dump whole large files.']
 prot={'claude':'CLAUDE_CODE_PROTOCOL.md','sol':'CODEX_CLI_PROTOCOL.md','luna':'CODEX_LUNA_TASK_PROTOCOL.md','freebuff':'FREEBUFF_PROTOCOL.md'}[lane]
 text += ['\n--- Existing lane protocol ---\n'+(c/prot).read_text()]
 text += ['\n--- Unattended additions ---\nNo questions to owner. Do not interact with another session or pane. Stay inside the assigned ID and owned paths. Do not steal work. Run focused tests. Keep changes on assigned branch/worktree. Commit coherent changes and push assigned branch. Write a schema-valid JSON receipt at '+str(c/'receipts'/f'{ident}.json')+' with exact task_id, status, summary, verification, executor_lane, model, worktree, branch, and session_id. status must be done only when all assigned acceptance checks passed; otherwise use needs-review or blocked and explain. Do not autonomously integrate into main. On quota, stop model work and preserve lease/tree.']
 text += ['\nFOOTAGE IMPACT: do not assume or invent recorded surfaces before a real baseline exists. If /home/dogfood-control/demo-assets/FOOTAGE_BASELINE.yaml exists, derive scene IDs/routes/components only from that manifest and task scope. Before receipt/integration include `footage_impact` with `reviewed_task_id` equal to this unit ID and `task_scope_reviewed` exactly equal to `<unit ID>: <canonical assignment title>`; then disposition UNAFFECTED, BASELINE_VALID, or RECAPTURE_REQUIRED; visual_scope NO_VISUAL_CHANGE, SCOPED_COMPATIBLE, or BROAD_REDESIGN; concise rationale; exact affected baseline scene IDs; and verification_evidence paths. For BASELINE_VALID include the affected scene run and current screenshot evidence. For RECAPTURE_REQUIRED name only invalidated scenes and include replacement evidence when captured. Do not infer redesign from UI-file changes alone; report task scope and functional/demo evidence. The integration controller enforces this receipt gate. It computes H+ from unattended.env: at H60 broad redesign and footage-invalidating changes are blocked; at H68+ UI changes require a scoped critical fix and verification, while work with no visual change may continue. Broad redesign remains blocked. Preserve the established visual direction and key actions.']
 text += ['If this task lands a materially UI-visible Stretch capability, write `/home/dogfood-control/run/video-stretch-delta.json` with task ID, feature, routes and why it changes the demo story. This queues an isolated footage delta after integration, never a product dependency. Do not signal backend-only or visually immaterial changes.']
 text += ['\n--- Explicit canonical assignment data ---\n'+json.dumps(obj,indent=2)]
 if batch: text += ['\nTasks in this batch (complete as a coherent batch):\n'+json.dumps(taskrows,indent=2)]
 if batch: text += ['The completion receipt must include `completed_tasks` listing every task ID in this batch exactly once. Do not claim batch success or downstream eligibility unless each listed task acceptance criterion is complete and the required checks passed.']
 text += ['Receipt schema: '+(c/'RECEIPT_SCHEMA.yaml').read_text()]
 handoff=ROOT/'handoffs'/lane/f'{ident}.md'
 text += ['\nUSAGE HANDOFF REQUIRED: '+str(handoff)+'. At meaningful boundaries and known usage-risk points, write an agent-authored checkpoint with `/home/dogfood-control/bin/conflux-handoff '+lane+' '+ident+' --worktree '+str(wt)+' --branch '+branch+' --phase PHASE --checkpoint "completed work; current state; decisions/invariants; relevant symbols; tests/results; failures; next actions" --next "next concrete action"`. Do this after investigation/plan, substantial implementation, before/after major tests, and before integration or intentional stop; avoid frequent injected prompts. Controller polling separately captures Git/controller/receipt/log state and preserves checkpoint authorship time. Do not copy transcripts or planning documents. On quota preserve lease/worktree and set HANDOFF_REQUIRED; never restart with this full prompt.']
 return '\n'.join(text)
def start_tmux(lane,ident,wt,prompt):
 sess='unattended-'+lane+'-'+ident.lower(); logname=f'{lane}-{ident}.jsonl'; out=ROOT/'logs/unattended'/logname; status=ROOT/'run'/f'{sess}.exit'; pidfile=ROOT/'run'/f'{sess}.pid'; pf=ROOT/'run'/f'{sess}.prompt'; sh=ROOT/'run'/f'{sess}.sh'
 if subprocess.run(['tmux','has-session','-t',sess],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0: return sess,status,out
 out.parent.mkdir(parents=True,exist_ok=True); status.unlink(missing_ok=True); out.touch(); pf.write_text(prompt)
 if lane=='claude':
  cmd=['/home/insightlabs38/.npm-global/bin/claude','--model','claude-sonnet-5','--effort','high','--dangerously-skip-permissions','--print','--verbose','--output-format','stream-json',prompt]
 elif lane in ('sol','luna'):
  model='gpt-6-sol' if lane=='sol' else 'gpt-6-luna'
  cmd=['/home/insightlabs38/.local/bin/codex','exec','--model',model,'-c','model_reasoning_effort=medium','--dangerously-bypass-approvals-and-sandbox','--json','-C',str(wt),prompt]
 else: raise RuntimeError('unsupported headless lane '+lane)
 lines=['#!/usr/bin/env bash','set +e','cd '+shlex.quote(str(wt)),'export DISABLE_AUTOUPDATER=1','unset OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL']
 quoted=' '.join(shlex.quote(x) for x in cmd)
 lines+=['(set -o pipefail; ('+quoted+') 2>&1 | /home/dogfood-control/bin/conflux-redact-log >> '+shlex.quote(str(out))+') &','pid=$!','printf "%s\\n" "$pid" > '+shlex.quote(str(pidfile)),'wait "$pid"','rc=$?','printf "%s\\n" "$rc" > '+shlex.quote(str(status)),'sleep 86400']
 sh.write_text('\n'.join(lines)+'\n'); sh.chmod(0o700)
 run(['tmux','new-session','-d','-s',sess,'-c',str(wt),'bash',str(sh)])
 return sess,status,out
def classify(path): return run([str(ROOT/'bin/conflux-outcome-classify'),str(path)],check=False).splitlines()[-1]
def process_ticks(pidfile):
 try: root=int(pidfile.read_text().strip())
 except Exception: return -1
 todo=[root]; seen=set(); total=0
 while todo:
  pid=todo.pop()
  if pid in seen: continue
  seen.add(pid)
  try:
   raw=pathlib.Path(f'/proc/{pid}/stat').read_text(); fields=raw[raw.rfind(')')+2:].split(); total+=int(fields[11])+int(fields[12])
   children=pathlib.Path(f'/proc/{pid}/task/{pid}/children').read_text().split(); todo.extend(int(x) for x in children)
  except Exception: pass
 return total
def pause_lane(lane,ident,reason,status='PAUSED_QUOTA',reset_at=None):
 row={'lane':lane,'status':status,'unit':ident,'at':now().isoformat(),'reason':reason}
 if reset_at: row['reset_at']=reset_at.isoformat()
 p=ROOT/'run/lanes'/f'{lane}.json'; p.parent.mkdir(parents=True,exist_ok=True); tmp=p.with_suffix(f'.{os.getpid()}.tmp'); tmp.write_text(json.dumps(row,indent=2)+'\n'); os.chmod(tmp,0o600); os.replace(tmp,p)
def quota_wait(path,step):
 import re
 txt=path.read_text(errors='replace') if path.exists() else ''
 match=re.search(r'(?:reset(?:s)?(?:\s+(?:time|at))?|available again(?:\s+at)?)\s*[:=]?\s*(20\d\d-\d\d-\d\d[T ]\d\d:\d\d(?::\d\d)?Z?)',txt,re.I)
 if match:
  try:
   stamp=dt.datetime.fromisoformat(match.group(1).replace('Z','+00:00'))
   if stamp.tzinfo is None: stamp=stamp.replace(tzinfo=dt.timezone.utc)
   return max(60,int((stamp.astimezone(dt.timezone.utc)-now()).total_seconds())+60),'explicit-reset'
  except Exception: pass
 return (300,900,1800,3600)[step],'bounded-backoff'
def prepare_worktree(lane,ident,batch):
 branch=f'{lane}/{ident}'; wt=WTROOT/f'{lane}-{ident}'; wt.parent.mkdir(parents=True,exist_ok=True)
 run(['git','-C',str(REPO),'fetch','origin','main'],check=False)
 if wt.exists():
  current=run(['git','-C',str(wt),'branch','--show-current'],check=False)
  if current!=branch: raise RuntimeError(f'existing worktree {wt} on unexpected branch {current}')
 else:
  run(['git','-C',str(REPO),'worktree','add','-b',branch,str(wt),'origin/main'])
 return branch,wt
def main():
 if len(sys.argv)!=2 or sys.argv[1] not in ('claude','sol','luna'): raise SystemExit('usage: conflux-unattended-worker {claude|sol|luna}')
 lane=sys.argv[1]; failures={}; last=None
 heartbeat(lane)
 if now()<H0: raise SystemExit('kickoff guard refused early worker')
 while now()<STOP:
  heartbeat(lane)
  lane_pause=ROOT/'run/lanes'/f'{lane}.json'
  if lane_pause.exists() and json.loads(lane_pause.read_text()).get('status') in ('PAUSED_QUOTA','PAUSED_AUTH','DISABLED'): return 0
  batch=lane in ('claude','sol'); prior=existing_lease(lane)
  if prior:
   ident=prior['id']; branch=prior.get('branch') or f'{lane}/{ident}'; wt=pathlib.Path(prior.get('worktree') or WTROOT/f'{lane}-{ident}')
  else:
   selection=ctrl('next-batch',lane) if batch else ctrl('next-task','luna')
   match=__import__('re').search(r'^candidate\s+(\S+)',selection,re.M)
   if not match:
    log(f'{lane}-claims.jsonl',{'event':'no_claim','detail':selection}); time.sleep(45); continue
   ident=match.group(1); branch=f'{lane}/{ident}'; wt=WTROOT/f'{lane}-{ident}'
  session=f'unattended-{lane}-{ident.lower()}'
  if not prior:
   if batch: out=ctrl('claim-batch',lane,ident,'--branch',branch,'--worktree',str(wt),'--session-id',session)
   else: out=ctrl('claim-task',lane,ident,'--branch',branch,'--worktree',str(wt),'--session-id',session)
   if out.startswith('ERROR:'):
    log(f'{lane}-claims.jsonl',{'event':'claim-race-or-block','id':ident,'detail':out}); time.sleep(2); continue
  try: branch,wt=prepare_worktree(lane,ident,batch)
  except Exception as e:
   log(f'{lane}-{ident}.jsonl',{'event':'worktree-infra-failure','detail':str(e)}); (ROOT/'execution/ATTENTION.md').write_text(f'# HIGH ATTENTION\n\n{lane} could not create assigned worktree for {ident}: {e}\n')
   if not batch: ctrl('review',ident)
   break
  receipt_path=ROOT/'execution/receipts'/f'{ident}.json'
  if receipt_path.exists():
   try: prior_receipt=json.loads(receipt_path.read_text())
   except Exception: prior_receipt={}
   if prior_receipt.get('task_id')==ident and prior_receipt.get('status')=='done':
    run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','FINAL_INTEGRATION','--reason','receipt complete; integration recovery without relaunch'])
    integ=run([str(ROOT/'bin/conflux-integrate'),lane,ident,str(wt)],check=False)
    if integ.returncode: log(f'{lane}-{ident}.jsonl',{'event':'integration_recovery_failure','output':integ.stdout}); ctrl('review',ident)
    else: log(f'{lane}-{ident}.jsonl',{'event':'integration_recovered','id':ident})
    (ROOT/'run/lanes'/f'{lane}.json').unlink(missing_ok=True)
    continue
  prompt=task_packet(lane,ident,batch,branch,wt)+f'\nExact branch: {branch}\nExact worktree: {wt}\nPinned model for this invocation: '+('claude-sonnet-5/high' if lane=='claude' else 'gpt-6-sol/medium' if lane=='sol' else 'gpt-6-luna/medium')
  handoff_path=ROOT/'handoffs'/lane/f'{ident}.md'
  if handoff_path.exists():
   recovery=ROOT/'run/recovery'/ident/'snapshot.json'
   prompt=('CONTINUATION — do not reread the control pack. Read '+str(handoff_path)+' and the passive recovery bundle '+str(recovery)+f'; inspect git status and git diff --stat in {wt}; inspect only relevant diff/symbols; continue next actions from the latest agent-authored checkpoint while using controller observations as facts, not narrative. Keep branch {branch}, worktree {wt}, unit {ident}. Do not claim another unit. Update handoff at meaningful boundaries and preserve receipt policy.')
  else:
   run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','INVESTIGATION_PLAN'])
  quota_step=0; retry_context=''
  while True:
   sess,status,logfile=start_tmux(lane,ident,wt,prompt+retry_context)
   heartbeat(lane,ident,sess)
   pidfile=ROOT/'run'/f'{sess}.pid'
   log(f'{lane}-{ident}.jsonl',{'event':'invocation_started','session':sess,'branch':branch,'worktree':str(wt)})
   start=now(); watchdog=False; last_ticks=process_ticks(pidfile); last_cpu=start
   while not status.exists():
    heartbeat(lane,ident,sess)
    age=(now()-start).total_seconds(); output_quiet=(time.time()-logfile.stat().st_mtime if logfile.exists() else age)
    ticks=process_ticks(pidfile)
    if ticks!=last_ticks and ticks>=0: last_ticks=ticks; last_cpu=now()
    inactive=(now()-last_cpu).total_seconds()
    if age>BOUNDS[lane] or (output_quiet>IDLE and inactive>IDLE):
     run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','watchdog requested orderly stop; preserve current working tree'])
     watchdog=True; subprocess.run(['tmux','send-keys','-t',sess,'C-c'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); time.sleep(10)
     subprocess.run(['tmux','kill-session','-t',sess],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
     log(f'{lane}-{ident}.jsonl',{'event':'watchdog','classification':'HANG','age':age,'output_quiet':output_quiet,'process_inactive':inactive})
     break
    time.sleep(5)
   rc=int(status.read_text().strip()) if status.exists() else 124
   receipt=ROOT/'execution/receipts'/f'{ident}.json'
   if rc==0 and receipt.exists() and json.loads(receipt.read_text()).get('status')=='done':
    integ=run([str(ROOT/'bin/conflux-integrate'),lane,ident,str(wt)],check=False)
    if integ.returncode: log(f'{lane}-{ident}.jsonl',{'event':'integration_failure','output':integ.stdout}); ctrl('review',ident)
    else: log(f'{lane}-{ident}.jsonl',{'event':'integrated','id':ident})
    subprocess.run(['tmux','kill-session','-t',sess],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    (ROOT/'run/lanes'/f'{lane}.json').unlink(missing_ok=True)
    break
   category='HANG' if watchdog else (classify(logfile) if logfile.exists() else 'HANG')
   run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','invocation ended with '+category])
   log(f'{lane}-{ident}.jsonl',{'event':'failed','classification':category,'exit_code':rc})
   if category=='QUOTA':
    delays=(300,900,1800,3600)
    if quota_step<len(delays):
     seconds,kind=quota_wait(logfile,quota_step); run(['tmux','kill-session','-t',sess])
     if kind=='bounded-backoff':
      run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','provider quota without reset timestamp; waiting for owner/provider confirmation'])
      pause_lane(lane,ident,'quota reset time unknown; owner confirmation required'); ctrl('note',f'{lane} PAUSED_QUOTA on {ident}; awaiting confirmed availability')
      if lane in ('sol','luna'):
       sibling='luna' if lane=='sol' else 'sol'; other=existing_lease(sibling); oid=other.get('id') if other else None
       if other: run([str(ROOT/'bin/conflux-handoff'),sibling,oid,'--worktree',str(other.get('worktree','')),'--branch',str(other.get('branch','')),'--phase','HANDOFF_REQUIRED','--reason','shared Codex provider quota reported by '+lane])
       pause_lane(sibling,oid,'shared Codex provider quota reported by '+lane); ctrl('note',f'Codex quota pauses {sibling} with its lease/worktree preserved')
      break
     if now()+dt.timedelta(seconds=seconds)>=STOP:
      run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','provider quota; awaiting confirmed reset'])
      pause_lane(lane,ident,'backoff would pass STOP_NEW_CLAIMS'); ctrl('note',f'{lane} PAUSED_QUOTA on {ident}; ownership/worktree preserved')
      if lane in ('sol','luna'):
       sibling='luna' if lane=='sol' else 'sol'; other=existing_lease(sibling); oid=other.get('id') if other else None
       if other: run([str(ROOT/'bin/conflux-handoff'),sibling,oid,'--worktree',str(other.get('worktree','')),'--branch',str(other.get('branch','')),'--phase','HANDOFF_REQUIRED','--reason','shared Codex quota reached campaign stop window'])
       pause_lane(sibling,oid,'shared Codex quota reached stop window')
      break
     pause_lane(lane,ident,f'provider reset scheduled in approximately {seconds}s',status='PAUSED_QUOTA')
     p=ROOT/'run/lanes'/f'{lane}.json'; row=json.loads(p.read_text()); row['reset_at']=(now()+dt.timedelta(seconds=seconds)).isoformat(); p.write_text(json.dumps(row,indent=2)+'\n')
     if lane in ('sol','luna'):
      sibling='luna' if lane=='sol' else 'sol'; other=existing_lease(sibling); oid=other.get('id') if other else None; reset_at=now()+dt.timedelta(seconds=seconds)
      if other: run([str(ROOT/'bin/conflux-handoff'),sibling,oid,'--worktree',str(other.get('worktree','')),'--branch',str(other.get('branch','')),'--phase','HANDOFF_REQUIRED','--reason','shared Codex reset scheduled; checkpoint created by supervisor'])
      pause_lane(sibling,oid,'shared Codex reset scheduled',reset_at=reset_at)
     run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','provider quota; awaiting automatic reset'])
     log(f'{lane}-{ident}.jsonl',{'event':'quota_backoff','seconds':seconds,'kind':kind,'step':quota_step+1})
     time.sleep(seconds); (ROOT/'run/lanes'/f'{lane}.json').unlink(missing_ok=True); quota_step+=1; retry_context='\n\nCONTINUATION: read '+str(ROOT/'handoffs'/lane/f'{ident}.md')+'; inspect git status and diff --stat; targeted retrieval only; continue next actions. Do not reread control pack.'; continue
    run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','bounded quota retries exhausted'])
    pause_lane(lane,ident,'bounded quota retries exhausted; ownership/worktree preserved');
    if lane in ('sol','luna'):
     sibling='luna' if lane=='sol' else 'sol'; other=existing_lease(sibling); oid=other.get('id') if other else None
     if other: run([str(ROOT/'bin/conflux-handoff'),sibling,oid,'--worktree',str(other.get('worktree','')),'--branch',str(other.get('branch','')),'--phase','HANDOFF_REQUIRED','--reason','shared Codex quota exhausted'])
     pause_lane(sibling,oid,'shared Codex quota exhausted')
    ctrl('note',f'{lane} PAUSED_QUOTA on {ident}; bounded backoff exhausted')
    break
   if category=='AUTH_FAILURE':
    run([str(ROOT/'bin/conflux-handoff'),lane,ident,'--worktree',str(wt),'--branch',branch,'--phase','HANDOFF_REQUIRED','--reason','provider authentication unavailable'])
    pause_lane(lane,ident,'provider authentication unavailable',status='PAUSED_AUTH')
    if lane in ('sol','luna'):
     sibling='luna' if lane=='sol' else 'sol'; other=existing_lease(sibling); oid=other.get('id') if other else None
     if other: run([str(ROOT/'bin/conflux-handoff'),sibling,oid,'--worktree',str(other.get('worktree','')),'--branch',str(other.get('branch','')),'--phase','HANDOFF_REQUIRED','--reason','shared Codex authentication unavailable'])
     pause_lane(sibling,oid,'shared Codex authentication unavailable',status='PAUSED_AUTH')
    log(f'{lane}-{ident}.jsonl',{'event':'paused-auth','id':ident}); break
   if category=='HANG':
    failures[ident]=failures.get(ident,0)+1
    if failures[ident]<2:
     subprocess.run(['tmux','kill-session','-t',sess],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
     log(f'{lane}-{ident}.jsonl',{'event':'hang_retry','attempt':2,'worktree':str(wt)})
     retry_context='\n\nRetry context: first invocation was interrupted by the watchdog. Resume from the existing worktree; inspect git status/diff before editing.'; continue
    (ROOT/'execution/ATTENTION.md').write_text(f'# HIGH ATTENTION\n\nSecond hang on {lane} unit {ident}. Branch and worktree preserved: {wt}.\n')
    subprocess.run(['tmux','kill-session','-t',sess],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    break
   subprocess.run(['tmux','kill-session','-t',sess],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
   ctrl('review',ident); log(f'{lane}-{ident}.jsonl',{'event':'review_release','classification':category}); break
  # A paused provider lane is not relaunched or replaced by another model.
  if (ROOT/'run/lanes'/f'{lane}.json').exists(): return 0
if __name__=='__main__': main()
