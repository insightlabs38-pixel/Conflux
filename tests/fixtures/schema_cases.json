    {
      "name": "null where it is not allowed",
      "schema": {
        "type": "integer",
        "minimum": 1
      },
      "value": null,
      "problems": [
        {
          "path": "",
          "code": "type"
        }
      ]
    },
    {
      "name": "a nullable value still obeys its bounds",
      "schema": {
        "type": ["integer", "null"],
        "minimum": 1
