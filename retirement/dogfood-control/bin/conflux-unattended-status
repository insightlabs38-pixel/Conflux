#!/usr/bin/env bash
set -euo pipefail
systemctl --user status conflux-unattended.service --no-pager || true
systemctl --user list-timers conflux-unattended.timer --all --no-pager
cat /home/dogfood-control/run/unattended-state.json 2>/dev/null || true
/home/dogfood-control/bin/conflux-control provider-status
/home/dogfood-control/bin/conflux-video-status
cat /home/dogfood-control/AUTONOMOUS_STATUS.md 2>/dev/null || true
python3 - <<'PY'
import datetime,json,pathlib
p=pathlib.Path('/home/dogfood-control/run/freebuff-state.json')
if p.exists():
 d=json.loads(p.read_text()); t=datetime.datetime.fromisoformat(d['launched_at']); age=int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()/60)
 log=pathlib.Path('/home/dogfood-control/logs/unattended/freebuff-status.jsonl')
 pane='unknown'
 if log.exists():
  for line in reversed(log.read_text(errors='replace').splitlines()):
   try:
    item=json.loads(line)
    if item.get('event')=='pane_update': pane=item.get('at','unknown'); break
   except Exception: pass
 print(f"Freebuff: unit={d.get('task')} branch={d.get('branch','unknown')} instance_age={age}m approaching_rollover={'yes' if age>=50 else 'no'} usage_limit_hit={d.get('session_limit_hit',False)} last_pane_activity={pane}")
else: print('Freebuff: idle; no current instance')
PY
find /home/dogfood-control/handoffs -type f -name '*.md' -printf '%TY-%Tm-%TdT%TH:%TM %p\n' 2>/dev/null | sort -r | head -12 || true
cat /home/dogfood-control/execution/ATTENTION.md 2>/dev/null || true
cat /home/dogfood-control/UNATTENDED_HANDOFF.md 2>/dev/null || true
