-  return (getRuntimeAppUrlFromEnv() ?? bundledWebsiteUrl).replace(/\/$/, '')
+  const websiteUrl = new URL(
+    (getRuntimeAppUrlFromEnv() ?? bundledWebsiteUrl).replace(/\/$/, ''),
+  )
+
+  // codebuff.com redirects to www.codebuff.com. Fetch follows that redirect,
+  // but browsers and runtimes may strip Authorization when the origin changes,
+  // making valid API keys appear invalid. Address the canonical host directly.
+  if (websiteUrl.protocol === 'https:' && websiteUrl.hostname === 'codebuff.com') {
+    websiteUrl.hostname = 'www.codebuff.com'
+  }
+
+  return websiteUrl.toString().replace(/\/$/, '')
 }
 
