# Copy to `.env` and adjust; all values have safe Compose defaults.
DJANGO_SECRET_KEY=change-me-in-deployments
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=conflux
POSTGRES_USER=conflux
POSTGRES_PASSWORD=conflux
POSTGRES_PORT=5432

VALKEY_PORT=6379

# Object store (RustFS by default; SeaweedFS in the compat profile)
S3_ACCESS_KEY=conflux
S3_SECRET_KEY=conflux-secret
S3_BUCKET_NAME=conflux-artifacts
S3_PORT=9000
S3_CONSOLE_PORT=9001
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333

# Public entry point
CONFLUX_PORT=8080

UVICORN_WORKERS=2
