#!/usr/bin/env python3
"""Tiered browser runner (PD-B03-T04). Tiers live in tests/e2e/tiers.json; every spec is in exactly one.

  read-only          reference scenario (seed 7), one Playwright run, 4 workers, never mutates shared state
  self-isolating     specs that provision their own fixtures (fixtures.ts); run inside the read-only run
  isolated-mutation  one throwaway `iso-min` fixture PER SPEC FILE, files run concurrently
  canary             the only serial chain: lifecycle -> scenes -> uiv2-organizer -> uiv2-final-states on
                     its own `canary` fixture (full create->submit->judge->publish path, untouched by others)

Usage: scripts/e2e-tiers check
       scripts/e2e-tiers run [tier ...]      PR/full: all three tiers concurrently (default) or the named ones
       scripts/e2e-tiers run --shard I/N     PR sharding: this job's slice of the work units (1-based I of N)
       scripts/e2e-tiers plan N              print the deterministic N-way split and its estimated balance
       scripts/e2e-tiers report [--check] [--kind K] [--window N]
                                             timing vs tests/e2e/targets.json and flake history of recent runs
                                             (artifacts/e2e-fast/history.jsonl, appended by every run); --check exits 1
                                             when a target, green streak or flake budget is breached
       scripts/e2e-tiers weights             refresh tests/e2e/weights.json from the last full run's reports
       scripts/e2e-tiers canary [--repeat N] release/nightly gate: the full lifecycle chain on N fresh canary fixtures
                                             (every run must pass; failed runs keep their fixture; pass rate reported)
       scripts/e2e-tiers smoke               seconds: sign-in, role workspaces and public pages, desktop only
       scripts/e2e-tiers affected [--base REF] [--list]
                                             only specs mapped (tests/e2e/affected.json) from paths changed vs REF
                                             (default HEAD: uncommitted + untracked); --list prints the selection
Release stays authoritative and broader: `make demo-e2e` (serial, reset-first, seed 7) plus the canary.
Env:   E2E_SKIP_PREFLIGHT  E2E_ISOLATED_JOBS (3)  E2E_READONLY_WORKERS (4)  E2E_MANAGE  E2E_BASE_URL  E2E_KEEP_FIXTURES=1
Fixtures are disposed on success and kept (slug printed) on failure; `make e2e-fixture-sweep` cleans up.
Specs run unmodified: fixture identity reaches them through E2E_DEMO_SEED / E2E_DEMO_PASSWORD.
"""
import json
import os
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from fnmatch import fnmatch
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPECS = ROOT / "tests/e2e"
CONFIG = "tests/e2e/playwright.config.ts"
LOGS = ROOT / "artifacts/e2e-fast"
RUN_TIERS = ("read-only", "isolated-mutation", "canary")
_print = threading.Lock()


def say(line):
    with _print:
        print(line, flush=True)


def tiers():
    return json.loads((SPECS / "tiers.json").read_text())


def check():
    declared = [(t, s) for t, names in tiers().items() for s in names]
    on_disk = {p.name.removesuffix(".spec.ts") for p in SPECS.glob("*.spec.ts")}
    problems = []
    seen = {}
    for tier, spec in declared:
        if spec in seen:
            problems.append(f"{spec} is in both {seen[spec]} and {tier}")
        seen[spec] = tier
        if spec not in on_disk:
            problems.append(f"{tier}: {spec}.spec.ts does not exist")
    cfg = json.loads((SPECS / "affected.json").read_text())
    named = set(cfg["smoke"]) | {sp for r in cfg["rules"] for sp in r["specs"]}
    problems += [f"affected.json names unclassified spec {sp}" for sp in sorted(named - set(seen))]
    problems += [f"{s}.spec.ts is not classified in tests/e2e/tiers.json" for s in sorted(on_disk - set(seen))]
    return problems


GROUPS, DIAGNOSED, KIND, REPEAT = [], [], None, None  # this invocation's Playwright groups, diagnostic re-runs, run kind
PREFIX = ""  # set by --shard so concurrent shards on one stack never share output/log directories


def weights():
    return json.loads((SPECS / "weights.json").read_text())


def units():
    """Indivisible work units: one per read-only/self-isolating spec, one per isolated spec, one canary chain."""
    t = tiers()
    return (
        [(f"read-only:{s}", "read-only", [s]) for s in t["read-only"] + t["self-isolating"]]
        + [(f"isolated-mutation:{s}", "isolated-mutation", [s]) for s in t["isolated-mutation"]]
        + [("canary:chain", "canary", list(t["canary"]))]
    )


def split(n):
    """Deterministic longest-processing-time split of units into n shards: [(seconds, [unit, ...]), ...]."""
    w = weights()
    default = sorted(w.values())[len(w) // 2] if w else 30
    shards = [(0.0, []) for _ in range(n)]
    for unit in sorted(units(), key=lambda u: (-w.get(u[0], default), u[0])):
        i = min(range(n), key=lambda k: (shards[k][0], k))
        shards[i] = (shards[i][0] + w.get(unit[0], default), shards[i][1] + [unit])
    return shards


def parse_shard(text):
    try:
        i, n = (int(x) for x in text.split("/"))
    except ValueError:
        i = n = 0
    if not 1 <= i <= n:
        raise SystemExit(f"--shard must look like I/N with 1 <= I <= N, got {text!r}")
    return i, n


def shard_selection(i, n):
    selection = {}
    for _, tier, specs in split(n)[i - 1][1]:
        selection.setdefault(tier, []).extend(specs)
    return selection


def refresh_weights():
    """Serial-equivalent seconds per unit from the last full run: read-only files are summed test time spread
    over the read-only workers; isolated specs and canary members use their own invocation's wall time."""
    t, out = tiers(), {}
    workers = int(os.environ.get("E2E_READONLY_WORKERS", "4"))
    report = json.loads((LOGS / "read-only" / "report.json").read_text())
    per_file = {}

    def walk(suite):
        for spec in suite.get("specs", []):
            for test in spec.get("tests", []):
                per_file[Path(spec["file"]).name.removesuffix(".spec.ts")] = per_file.get(Path(spec["file"]).name.removesuffix(".spec.ts"), 0) + sum(r["duration"] for r in test["results"])
        for child in suite.get("suites", []):
            walk(child)

    for suite in report["suites"]:
        walk(suite)
    for spec in t["read-only"] + t["self-isolating"]:
        out[f"read-only:{spec}"] = round(per_file.get(spec, 0) / 1000 / workers + 1, 1)
    for spec in t["isolated-mutation"]:
        out[f"isolated-mutation:{spec}"] = round(json.loads((LOGS / f"iso-{spec}" / "report.json").read_text())["stats"]["duration"] / 1000, 1)
    out["canary:chain"] = round(sum(json.loads((LOGS / f"canary-{spec}" / "report.json").read_text())["stats"]["duration"] for spec in t["canary"]) / 1000, 1)
    (SPECS / "weights.json").write_text(json.dumps(dict(sorted(out.items())), indent=2) + "\n")
    return out


def targets():
    return json.loads((SPECS / "targets.json").read_text())


def _durations(report):
    per_spec = {}

    def walk(suite):
        for spec in suite.get("specs", []):
            name = Path(spec["file"]).name.removesuffix(".spec.ts")
            for test in spec.get("tests", []):
                per_spec[name] = per_spec.get(name, 0) + sum(r["duration"] for r in test["results"]) / 1000
        for child in suite.get("suites", []):
            walk(child)

    for suite in report.get("suites", []):
        walk(suite)
    return per_spec


def record(kind, code, wall):
    """Append one line per invocation: the raw material for timing targets and flake diagnostics."""
    totals = {"expected": 0, "skipped": 0, "unexpected": 0, "flaky": 0}
    per_spec = {}
    for group in sorted(set(GROUPS)):
        try:
            report = json.loads((LOGS / group / "report.json").read_text())
        except (OSError, ValueError):
            continue
        for key in totals:
            totals[key] += report["stats"].get(key, 0)
        for name, seconds in _durations(report).items():
            per_spec[name] = per_spec.get(name, 0) + seconds
    head = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT, capture_output=True, text=True).stdout.strip()
    dirty = bool(subprocess.run(["git", "status", "--porcelain", "--untracked-files=no"], cwd=ROOT, capture_output=True, text=True).stdout.strip())
    entry = {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "kind": kind, "ok": code == 0,
        "wall_s": round(wall, 1), "commit": head + ("+dirty" if dirty else ""),
        "passed": totals["expected"], "skipped": totals["skipped"], "failed": totals["unexpected"], "flaky": totals["flaky"],
        "slowest": [[n, round(v, 1)] for n, v in sorted(per_spec.items(), key=lambda kv: -kv[1])[:5]],
        "diagnosed": DIAGNOSED,
        "repeat": REPEAT,
    }
    LOGS.mkdir(parents=True, exist_ok=True)
    with (LOGS / "history.jsonl").open("a") as fh:
        fh.write(json.dumps(entry) + "\n")


def report(argv):
    cfg = targets()
    window = int(argv[argv.index("--window") + 1]) if "--window" in argv else cfg["reliability"]["window"]
    only = argv[argv.index("--kind") + 1] if "--kind" in argv else None
    try:
        rows = [json.loads(line) for line in (LOGS / "history.jsonl").read_text().splitlines() if line.strip()]
    except OSError:
        rows = []
    breaches = []
    for kind in sorted({r["kind"] for r in rows}):
        if only and kind != only:
            continue
        runs = [r for r in rows if r["kind"] == kind][-window:]
        walls = sorted(r["wall_s"] / (r.get("repeat") or 1) for r in runs)
        median, worst = walls[len(walls) // 2], walls[-1]
        green = sum(r["ok"] and not r["failed"] and not r["flaky"] and not any(d["passed_on_rerun"] for d in r["diagnosed"]) for r in runs)
        streak = next((i for i, r in enumerate(reversed(runs)) if not r["ok"] or r["failed"] or r["flaky"]), len(runs))
        target = cfg.get(kind, {}).get("wall_s")
        flaky = [d for r in runs for d in r["diagnosed"] if d["passed_on_rerun"]]
        say(f"{kind:<8} last {len(runs):>2} runs: green {green}/{len(runs)}  wall median {median:.0f}s max {worst:.0f}s"
            + (f"  target {target}s" if target else "  (no target)") + f"  flaky events {len(flaky)}")
        slow = {}
        for r in runs:
            for name, seconds in r["slowest"]:
                slow.setdefault(name, []).append(seconds)
        say("         slowest specs (median s): " + ", ".join(f"{n} {sorted(v)[len(v) // 2]:.0f}" for n, v in sorted(slow.items(), key=lambda kv: -max(kv[1]))[:5]))
        for f in flaky:
            say(f"         FLAKY: {', '.join(f['specs'])} failed in {f['group']} and passed on re-run")
        if target and median > target:
            breaches.append(f"{kind}: median wall {median:.0f}s > target {target}s")
        if len(runs) >= cfg["reliability"]["window"] and green < len(runs):
            breaches.append(f"{kind}: only {green}/{len(runs)} clean runs in the last {len(runs)} (budget: 0 failures, 0 flakes)")
        if kind in ("full", "canary") and streak < min(len(runs), 1):
            breaches.append(f"{kind}: latest run was not green")
    if not rows:
        say("no history yet: run the suite first (every run appends to artifacts/e2e-fast/history.jsonl)")
    for b in breaches:
        say(f"BREACH {b}")
    return 1 if breaches and "--check" in argv else 0


def manage(*args):
    prefix = os.environ.get("E2E_MANAGE", "docker compose exec -T app python manage.py").split()
    out = subprocess.run([*prefix, "e2e_fixture", *args], cwd=ROOT, capture_output=True, text=True)
    if out.returncode:
        raise RuntimeError(f"e2e_fixture {' '.join(args)}: {(out.stderr.strip().splitlines() or ['failed'])[-1]}")
    return out.stdout.strip().splitlines()[-1] if out.stdout.strip() else ""


def failed_specs(group):
    """Spec names with a failing test in the group's JSON report."""
    try:
        report = json.loads((LOGS / group / "report.json").read_text())
    except (OSError, ValueError):
        return []
    found = set()

    def walk(suite):
        if any(not spec.get("ok", True) for spec in suite.get("specs", [])):
            found.add(Path(suite.get("file", "")).name.removesuffix(".spec.ts"))
        for child in suite.get("suites", []):
            walk(child)

    for suite in report.get("suites", []):
        walk(suite)
    return sorted(found - {""})


def playwright(group, specs, env=None, workers=1, extra=(), diagnose=True):
    group = PREFIX + group
    GROUPS.append(group)
    LOGS.mkdir(parents=True, exist_ok=True)
    log = LOGS / f"tier-{group}.log"
    with log.open("w") as fh:
        code = subprocess.run(
            ["npx", "playwright", "test", "-c", CONFIG, f"--workers={workers}", *extra, *specs],
            cwd=ROOT, env={**os.environ, "E2E_GROUP": group, **(env or {})}, stdout=fh, stderr=subprocess.STDOUT,
        ).returncode
    summary = [l.strip() for l in log.read_text().splitlines() if "✘" in l or " passed" in l or " failed" in l or " skipped" in l]
    say(f"[{group}] exit {code}: " + "; ".join(summary[-4:]))
    if code and diagnose and not os.environ.get("E2E_NO_DIAGNOSE"):
        diagnostic_rerun(group, env, extra)
    return code


def diagnostic_rerun(group, env, extra):
    """Failure-first tracing: nothing is recorded on the way in, so re-run only the failing files
    once with a trace. Diagnostic only: the tier stays failed whatever the re-run does. Chains that
    consume state (the canary) are not re-run; their fixture is kept instead."""
    specs = failed_specs(group)  # group already carries the shard prefix
    if not specs or any(tier_of(s) == "canary" for s in specs):
        return
    diag = f"{group}-diagnose"  # group already carries the shard prefix
    say(f"[{group}] diagnostic re-run with trace: {', '.join(specs)}")
    code = subprocess.run(
        ["npx", "playwright", "test", "-c", CONFIG, "--workers=1", *extra, *specs],
        cwd=ROOT, env={**os.environ, "E2E_GROUP": diag, "E2E_TRACE": "on", **(env or {})},
        stdout=(LOGS / f"tier-{diag}.log").open("w"), stderr=subprocess.STDOUT,
    ).returncode
    DIAGNOSED.append({"group": group, "specs": specs, "passed_on_rerun": code == 0})
    verdict = "failed again" if code else "PASSED on re-run: treat as flaky/state-dependent, not as a pass"
    say(f"[{group}] diagnostic re-run {verdict}; traces in artifacts/e2e-fast/{diag}/results/**/trace.zip (npx playwright show-trace)")


def with_fixture(profile, group, specs):
    """Provision a fixture, run specs one file at a time against it, dispose unless something failed."""
    fixture = json.loads(manage("create", profile))
    env = {"E2E_DEMO_SEED": str(fixture["seed"]), "E2E_DEMO_PASSWORD": fixture["password"]}
    code = 0
    for spec in specs:
        code = playwright(f"{group}-{spec}" if len(specs) > 1 else group, [spec], env) or code
        if code:
            break
    if code or os.environ.get("E2E_KEEP_FIXTURES"):
        say(f"[{group}] kept fixture {fixture['slug']} (seed {fixture['seed']}); dispose: manage.py e2e_fixture dispose {fixture['slug']}")
    else:
        manage("dispose", fixture["slug"])
    return code


def run_read_only(specs=None):
    t = tiers()
    return playwright("read-only", specs or t["read-only"] + t["self-isolating"], workers=int(os.environ.get("E2E_READONLY_WORKERS", "4")))


def run_isolated(specs=None):
    jobs = int(os.environ.get("E2E_ISOLATED_JOBS", "3"))
    with ThreadPoolExecutor(jobs) as pool:
        codes = list(pool.map(lambda s: with_fixture("iso-min", f"iso-{s}", [s]), specs or tiers()["isolated-mutation"]))
    return int(any(codes))


def canary_chain(specs=None):
    """Later chain members read what earlier ones create: run the chain up to the last selected one."""
    chain = tiers()["canary"]
    return chain[: max(chain.index(s) for s in specs) + 1] if specs else chain


def run_canary(specs=None):
    return with_fixture("canary", "canary", canary_chain(specs))


RUNNERS = {"read-only": run_read_only, "isolated-mutation": run_isolated, "canary": run_canary}


def tier_of(spec):
    t = tiers()
    return "read-only" if spec in t["self-isolating"] else next((k for k in RUN_TIERS if spec in t[k]), None)


def changed_paths(base):
    tracked = subprocess.run(["git", "diff", "--name-only", base], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
    fresh = subprocess.run(["git", "ls-files", "-o", "--exclude-standard"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
    return sorted(set(tracked + fresh))


def select_affected(paths):
    """(specs, reasons): union of mapped specs; 'all' wins; unmapped source paths fall back to smoke."""
    cfg = json.loads((SPECS / "affected.json").read_text())
    hit = lambda path, globs: any(fnmatch(path, g) for g in globs)
    specs, reasons, everything = set(), [], False
    for path in paths:
        direct = path.startswith("tests/e2e/") and path.endswith(".spec.ts")
        if hit(path, cfg["all"]):
            everything = True
            reasons.append(f"{path} -> ALL (shared infrastructure)")
        elif direct and tier_of(Path(path).name.removesuffix(".spec.ts")):
            name = Path(path).name.removesuffix(".spec.ts")
            specs.add(name)
            reasons.append(f"{path} -> {name}")
        elif hit(path, cfg["none"]):
            reasons.append(f"{path} -> none")
        else:
            mapped = sorted({sp for r in cfg["rules"] if hit(path, r["paths"]) for sp in r["specs"]})
            if mapped:
                specs.update(mapped)
                reasons.append(f"{path} -> {', '.join(mapped)}")
            elif path.startswith(("src/", "tests/e2e/", "scripts/")):
                specs.update(cfg["smoke"])
                reasons.append(f"{path} -> smoke (unmapped; add a rule to tests/e2e/affected.json)")
            else:
                reasons.append(f"{path} -> none")
    return (None if everything else sorted(specs)), reasons


def preflight():
    if os.environ.get("E2E_SKIP_PREFLIGHT"):
        return True
    # Reuse the running stack; only start/seed what is missing (scripts/e2e-stack).
    if subprocess.run([str(ROOT / "scripts/e2e-stack"), "ensure", "--fix"], cwd=ROOT).returncode:
        print("preflight failed: fix the stack (see above) or set E2E_SKIP_PREFLIGHT=1", file=sys.stderr)
        return False
    return True


def run_tiers(chosen, selection=None):
    results = {}

    def go(tier):
        try:
            results[tier] = RUNNERS[tier](selection.get(tier) if selection else None)
        except Exception as exc:  # provisioning failures must fail the run loudly, not skip
            say(f"[{tier}] ERROR {exc}")
            results[tier] = 1

    threads = [threading.Thread(target=go, args=(t,)) for t in chosen]
    [t.start() for t in threads]
    [t.join() for t in threads]
    say("== " + ", ".join(f"{t}: {'ok' if results[t] == 0 else 'FAILED'}" for t in chosen))
    return int(any(results.values()))


def main(argv):
    global PREFIX, KIND, REPEAT
    problems = check()
    if argv[:1] == ["check"] or problems:
        for p in problems:
            print(f"tiers: {p}", file=sys.stderr)
        print("tiers: OK" if not problems else "tiers: FAILED", file=sys.stderr)
        return 1 if problems else 0
    command = argv[0] if argv else "run"
    if command == "report":
        return report(argv)
    if command == "canary":
        KIND = "canary"
        repeat = int(argv[argv.index("--repeat") + 1]) if "--repeat" in argv else 1
        REPEAT = repeat
        if repeat < 1 or not preflight():
            return 1 if repeat >= 1 else 2
        results = []
        for run in range(1, repeat + 1):
            PREFIX = f"r{run}of{repeat}-" if repeat > 1 else ""
            results.append(run_canary() == 0)
        say(f"== canary gate: {sum(results)}/{repeat} runs passed" + ("" if all(results) else " — FAILED (kept fixtures listed above)"))
        return 0 if all(results) else 1
    if command == "smoke":
        KIND = "smoke"
        if not preflight():
            return 1
        smoke = json.loads((SPECS / "affected.json").read_text())["smoke"]
        code = playwright("smoke", smoke, workers=len(smoke), extra=("--project=desktop",))
        say(f"== smoke: {'ok' if code == 0 else 'FAILED'}")
        return code
    if command == "affected":
        KIND = "affected"
        base = argv[argv.index("--base") + 1] if "--base" in argv else "HEAD"
        paths = changed_paths(base)
        specs, reasons = select_affected(paths)
        for r in reasons:
            say(f"  {r}")
        if specs is None:
            say(f"affected vs {base}: ALL tiers (shared infrastructure changed)")
            selection, KIND = None, "full"  # measured against the full-run target, not the affected one
        elif not specs:
            say(f"affected vs {base}: nothing to run ({len(paths)} changed path(s) map to no browser spec)")
            return 0
        else:
            selection = {}
            for spec in specs:
                selection.setdefault(tier_of(spec), []).append(spec)
            say(f"affected vs {base}: " + "; ".join(f"{t}: {', '.join(v)}" for t, v in selection.items()))
            if "canary" in selection:
                say("  canary runs as a chain: " + " -> ".join(canary_chain(selection["canary"])))
        if "--list" in argv or not preflight():
            return 0 if "--list" in argv else 1
        return run_tiers([t for t in RUN_TIERS if selection is None or t in selection], selection)
    if command == "plan":
        n = int(argv[1]) if argv[1:] else 0
        if n < 1:
            print("usage: e2e-tiers plan N", file=sys.stderr)
            return 2
        shards = split(n)
        for k, (seconds, members) in enumerate(shards, 1):
            say(f"shard {k}/{n}  ~{seconds:.0f}s  " + ", ".join(u[0] for u in members))
        total = sum(sec for sec, _ in shards)
        say(f"total ~{total:.0f}s; slowest shard ~{max(sec for sec, _ in shards):.0f}s (ideal ~{total / n:.0f}s)")
        return 0
    if command == "weights":
        say(json.dumps(refresh_weights(), indent=1))
        return 0
    selection, rest = None, [a for a in argv[1:] if not a.startswith("--shard")]
    if "--shard" in argv:
        i, n = parse_shard(argv[argv.index("--shard") + 1])
        rest = [a for a in rest if a != argv[argv.index("--shard") + 1]]
        PREFIX, selection = f"s{i}of{n}-", shard_selection(i, n)
        say(f"shard {i}/{n}: " + "; ".join(f"{t}: {', '.join(v)}" for t, v in selection.items()))
    KIND = "shard" if selection is not None else ("subset" if rest else "full")
    chosen = rest if command == "run" and rest else list(RUN_TIERS)
    if selection is not None:
        chosen = [t for t in chosen if t in selection]
    unknown = [t for t in chosen if t not in RUNNERS]
    if command not in ("run",) or unknown:
        print(f"usage: e2e-tiers check|run [tier...] [--shard I/N]|plan N|weights|smoke|affected [--base REF] [--list]; unknown {unknown or command}", file=sys.stderr)
        return 2
    return run_tiers(chosen, selection) if preflight() else 1


def cli(argv):
    started = time.monotonic()
    code = main(argv)
    if KIND and GROUPS:
        record(KIND, code, time.monotonic() - started)
    return code


if __name__ == "__main__":
    sys.exit(cli(sys.argv[1:]))
