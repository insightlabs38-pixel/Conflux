          "type": "string"
        }
      },
      "value": "abc",
      "problems": [
        {
          "path": "",
          "code": "max_items"
        }
      ]
    },
    {
      "name": "an array of enum values",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["x", "y"]
        }
      },
      "value": ["x", "y"],
      "normalized": ["x", "y"]
    },
    {
      "name": "an object fills its defaults and keeps declared keys in order",
      "schema": {
        "type": "object",
        "properties": {
          "b": {
            "type": "string",
            "maxLength": 5,
            "default": "B"
          },
          "a": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9,
            "default": 1
          }
        }
      },
      "value": {
        "a": 2
      },
      "normalized": {
        "b": "B",
        "a": 2
      }
    },
    {
      "name": "a permissive object drops unknown keys",
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 5,
            "default": ""
          }
        }
      },
      "value": {
        "a": "x",
        "zzz": 1
      },
      "normalized": {
        "a": "x"
      }
    },
    {
      "name": "a strict object refuses unknown keys",
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 5,
            "default": ""
          }
        },
        "additionalProperties": false
      },
      "value": {
        "a": "x",
        "zzz": 1
      },
      "problems": [
        {
          "path": "",
          "code": "unknown_fields"
        }
      ]
    },
    {
      "name": "an object needs an object",
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "default": ""
          }
        }
      },
      "value": [],
      "problems": [
        {
          "path": "",
          "code": "type"
        }
      ]
    },
    {
      "name": "a missing required property",
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 5
          }
        },
        "required": ["a"]
      },
      "value": {},
      "problems": [
        {
          "path": "a",
          "code": "required"
        }
      ]
    },
    {
      "name": "an omitted optional property stays absent",
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 5
          }
        }
      },
      "value": {},
      "normalized": {}
    },
    {
      "name": "a nested problem names its whole path",
      "schema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 2,
                  "default": ""
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "value": {
        "rows": [
          {
            "name": "ab"
          },
          {
            "name": "abc"
          }
        ]
      },
      "problems": [
        {
          "path": "rows[1].name",
          "code": "max_length"
        }
      ]
    },
    {
      "name": "problems come in declaration order",
      "schema": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "maxLength": 1,
            "default": ""
          },
          "second": {
            "type": "string",
            "maxLength": 1,
            "default": ""
          }
        }
      },
      "value": {
        "first": "aa",
        "second": "bb"
      },
      "problems": [
        {
          "path": "first",
          "code": "max_length"
        },
        {
          "path": "second",
          "code": "max_length"
        }
      ]
    },
    {
      "name": "a required nonblank default fails until filled",
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 9,
            "default": "",
            "x-nonblank": true
          }
        }
      },
      "value": {},
      "problems": [
        {
          "path": "title",
          "code": "required"
        }
      ]
    },
    {
      "name": "an object enum on a number",
      "schema": {
        "type": "integer",
        "enum": [1, 2, 3]
      },
      "value": 2,
      "normalized": 2
    }
