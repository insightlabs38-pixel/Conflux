{
  "about": "Shared by pytest (tests/integration/test_schema_subset.py) and vitest (src/web/lib/schema.test.ts). Problems are compared by path and code, in order.",
  "cases": [
    {
      "name": "a string within its bounds",
      "schema": {
        "type": "string",
        "minLength": 2,
        "maxLength": 5
      },
      "value": "abc",
      "normalized": "abc"
    },
    {
      "name": "a string too long",
      "schema": {
        "type": "string",
        "maxLength": 3
      },
      "value": "abcd",
      "problems": [
        {
          "path": "",
          "code": "max_length"
        }
      ]
    },
    {
      "name": "a string too short",
      "schema": {
        "type": "string",
        "minLength": 2
      },
      "value": "a",
      "problems": [
        {
          "path": "",
          "code": "min_length"
        }
      ]
    },
    {
      "name": "text counted in characters not bytes",
      "schema": {
        "type": "string",
        "maxLength": 2
      },
      "value": "\u00e9\ud83d\ude00",
      "normalized": "\u00e9\ud83d\ude00"
    },
    {
      "name": "a number is not text",
      "schema": {
        "type": "string",
        "maxLength": 5
      },
      "value": 12,
      "problems": [
        {
          "path": "",
          "code": "type"
        }
      ]
    },
    {
      "name": "a nonblank string refuses spaces",
      "schema": {
        "type": "string",
        "maxLength": 5,
        "x-nonblank": true
      },
      "value": "   ",
      "problems": [
        {
          "path": "",
          "code": "required"
        }
      ]
    },
    {
      "name": "a string enum",
      "schema": {
        "type": "string",
        "enum": ["a", "b"]
      },
      "value": "b",
      "normalized": "b"
    },
    {
      "name": "a string outside its enum",
      "schema": {
        "type": "string",
        "enum": ["a", "b"]
      },
      "value": "c",
      "problems": [
        {
          "path": "",
          "code": "enum"
        }
      ]
    },
    {
      "name": "a date-time with an offset",
      "schema": {
        "type": "string",
        "format": "date-time"
      },
      "value": "2027-03-06T10:00:00-05:00",
      "normalized": "2027-03-06T10:00:00-05:00"
    },
    {
      "name": "a date-time with Z",
      "schema": {
        "type": "string",
        "format": "date-time"
      },
      "value": "2027-03-06T15:00:00Z",
      "normalized": "2027-03-06T15:00:00Z"
    },
    {
      "name": "a date-time without an offset",
      "schema": {
        "type": "string",
        "format": "date-time"
      },
      "value": "2027-03-06T10:00:00",
      "problems": [
        {
          "path": "",
          "code": "format"
        }
      ]
    },
    {
      "name": "not a date-time",
      "schema": {
        "type": "string",
        "format": "date-time"
      },
      "value": "soon",
      "problems": [
        {
          "path": "",
          "code": "format"
        }
      ]
    },
