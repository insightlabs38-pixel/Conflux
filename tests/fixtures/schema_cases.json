    {
      "name": "an array too short",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 3
        },
        "minItems": 2
      },
      "value": ["a"],
      "problems": [
        {
          "path": "",
          "code": "min_items"
        }
      ]
    },
    {
      "name": "an array item is checked and located",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1
        }
      },
      "value": ["a", "bb", "c"],
      "problems": [
        {
          "path": "[1]",
          "code": "max_length"
        }
      ]
