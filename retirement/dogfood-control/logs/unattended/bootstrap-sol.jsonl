d=wt,text=True).splitlines()\n if not all(allowed(n,paths) for n in names): fail('INTEGRATION_FAILURE',f'{a.ident} changed paths outside ownership: '+', '.join(n for n in names if not allowed(n,paths)))\n with LOCK.open('a+') as lock:\n  fcntl.flock(lock,fcntl.LOCK_EX)\n  if a.bootstrap:\n   if run(['git','status','--porcelain'],wt)[1].strip(): fail('INTEGRATION_FAILURE','bootstrap tree not clean')\n   mainchecks(wt,data)\n   code,out=run(['git','push','origin','HEAD:refs/heads/main'],wt)\n   if code: fail('INTEGRATION_FAILURE','bootstrap push main failed: '+out[-1400:])\n   run(['git','branch','-f','main','HEAD'],wt)\n   code,out=run([str(ROOT/'bin/conflux-control'),'complete-batch',a.ident,'--receipt',str(receipt)])\n   if code: fail('INTEGRATION_FAILURE','controller could not mark bootstrap complete: '+out)\n   (ROOT/'run/bootstrap-green').write_text(subprocess.check_output(['git','rev-parse','HEAD'],cwd=wt,text=True).strip()+'\\n')\n   return\n  code,out=run(['git','fetch','origin','main'],wt)\n  if code: fail('INTEGRATION_FAILURE','fetch main failed: '+out[-1000:])\n  code,out=run(['git','rebase','origin/main'],wt)\n  if code:\n   run(['git','rebase','--abort'],wt); run([str(ROOT/'bin/conflux-control'),'review',a.ident]); fail('INTEGRATION_FAILURE','rebase conflict; branch preserved for review: '+out[-1400:])\n  names=subprocess.check_output(['git','diff','--name-only','origin/main...HEAD'],cwd=wt,text=True).splitlines()\n  if not all(allowed(n,paths) for n in names): fail('INTEGRATION_FAILURE','rebased changes exceed ownership')\n  mainchecks(wt,data)\n  code,out=run(['git','push','origin',f'HEAD:refs/heads/{a.lane}/{a.ident}'],wt)\n  if code: fail('INTEGRATION_FAILURE','worker branch push failed: '+out[-1000:])\n  code,out=run(['git','push','origin','HEAD:refs/heads/main'],wt)\n  if code: run([str(ROOT/'bin/conflux-control'),'review',a.ident]); fail('INTEGRATION_FAILURE','main push rejected; review required: '+out[-1200:])\n  run(['git','-C',str(REPO),'fetch'