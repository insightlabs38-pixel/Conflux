#!/usr/bin/env python3
"""Passively preserve observable unit state without inventing agent narrative."""
import datetime as dt,json,os,pathlib,subprocess,sys
ROOT=pathlib.Path('/home/dogfood-control'); RUN=ROOT/'run'
def utcnow(): return dt.datetime.now(dt.timezone.utc)
def git(wt,*args):
 try:
  p=subprocess.run(['git','-C',str(wt),*args],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=30)
  return {'exit_code':p.returncode,'output':p.stdout}
 except Exception as e: return {'exit_code':None,'output':str(e)}
def atomic(path,data):
 path.parent.mkdir(parents=True,exist_ok=True); tmp=path.with_suffix(path.suffix+'.tmp'); tmp.write_text(data); os.chmod(tmp,0o600); os.replace(tmp,path)
def preserve_if_changed(path,data):
 if path.exists() and path.read_text(errors='replace')==data: return
 atomic(path,data)
def main():
 if len(sys.argv)!=2: raise SystemExit('usage: conflux-recovery-snapshot UNIT_ID')
 unit=sys.argv[1]; control=ROOT/'execution'; ownership=json.loads('{}')
 try:
  import yaml
  ownership=yaml.safe_load((control/'OWNERSHIP.yaml').read_text()) or {}
 except Exception as e: ownership={'read_error':str(e)}
 lease=next((x for x in ownership.get('leases',[])+ownership.get('reserved_batches',[]) if x.get('id')==unit),{})
 lane=lease.get('lane','unknown'); wt=pathlib.Path(lease.get('worktree','/nonexistent'))
 handoff=ROOT/'handoffs'/lane/(unit+'.md'); authored=None; authored_at=None
 if handoff.exists():
  import re
  body=handoff.read_text(errors='replace')
  m=re.search(r'## Agent-authored checkpoint\nAuthored at: (.*?)\n(.*?)(?=\n## |\Z)',body,re.S)
  if m and m.group(1)!='unavailable': authored_at=m.group(1); authored=m.group(2).strip()
  else:
   # Legacy handoffs predate authorship metadata; preserve their exact text, but don't claim a fresh checkpoint time.
   old=re.search(r'## Durable checkpoint\n(.*?)(?=\n## |\Z)',body,re.S)
   if old: authored=old.group(1).strip()
 handoff_age=None
 if authored_at:
  try: handoff_age=max(0,int((utcnow()-dt.datetime.fromisoformat(authored_at)).total_seconds()))
  except ValueError: pass
 receipt_path=control/'receipts'/(unit+'.json'); receipt=None
 try: receipt=json.loads(receipt_path.read_text())
 except Exception: pass
 log=ROOT/'logs/unattended'/f'{lane}-{unit}.jsonl'
 recent=log.read_text(errors='replace')[-10000:] if log.exists() else ''
 status=git(wt,'status','--short','--untracked-files=all'); head=git(wt,'rev-parse','HEAD')
 snap={'observed_at':utcnow().isoformat(timespec='seconds'),'unit_id':unit,'lane':lane,'ownership_lease':lease or None,
       'controller_state':(json.loads((RUN/'unattended-state.json').read_text()) if (RUN/'unattended-state.json').exists() else {}),
       'worktree':str(wt),'worktree_exists':wt.exists(),'branch':(git(wt,'branch','--show-current')['output'].strip() or None),'head':head['output'].strip() if head['exit_code']==0 else None,
       'git_status':status,'diff_stat':git(wt,'diff','--stat'),'diff_name_only':git(wt,'diff','--name-only'),'staged_diff_stat':git(wt,'diff','--cached','--stat'),
       'verification_receipt':receipt,'handoff_path':str(handoff),'agent_checkpoint':authored,'agent_checkpoint_authored_at':authored_at,'agent_checkpoint_age_seconds':handoff_age,
       'recent_execution_output':recent}
 dest=RUN/'recovery'/unit; dest.mkdir(parents=True,exist_ok=True)
 atomic(dest/'snapshot.json',json.dumps(snap,indent=2)+'\n')
 patch=git(wt,'diff','--binary')['output'] if wt.exists() else ''
 preserve_if_changed(dest/'working-tree.patch',patch)
 staged=git(wt,'diff','--cached','--binary')['output'] if wt.exists() else ''
 preserve_if_changed(dest/'staged.patch',staged)
 print(dest/'snapshot.json')
if __name__=='__main__': main()
