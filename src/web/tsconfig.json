{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@conflux/sdk": ["../../sdks/typescript/index.ts"]
    }
  },
  "include": [
    "app",
    "features",
    "components",
    "blocks",
    "hooks",
    "lib",
    "vite.config.ts"
  ]
}
